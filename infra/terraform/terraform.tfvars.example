# ========== Basic Configuration ==========
project_name = "voice-medical"
environment  = "dev"  # dev, staging, prod
aws_region   = "us-east-1"

# ========== Container Image ==========
# AWS ECR example:
#   container_image = "123456789.dkr.ecr.us-east-1.amazonaws.com/voice-medical:latest"
# Docker Hub example:
#   container_image = "docker.io/yourname/voice-medical:latest"
container_image = "123456789.dkr.ecr.us-east-1.amazonaws.com/voice-medical:latest"

# ========== ECS Sizing ==========
# Task CPU: 256, 512, 1024, 2048, 4096
# Recommended memory by CPU:
#   256 CPU   -> 512-1024 MB
#   512 CPU   -> 1024-2048 MB
#   1024 CPU  -> 2048-4096 MB
#   2048 CPU  -> 4096-8192 MB
ecs_task_cpu     = 1024
ecs_task_memory  = 2048
ecs_desired_count = 2
ecs_min_capacity = 1
ecs_max_capacity = 5

# ========== MongoDB Configuration ==========
# MongoDB Atlas:
#   mongodb+srv://user:password@cluster.mongodb.net/?appName=app
# Local MongoDB:
#   mongodb://mongodb:27017
mongodb_uri = "mongodb+srv://username:password@cluster.mongodb.net/?appName=voice-medical"
mongodb_db  = "voice_medical"

# ========== AI Model Configuration ==========
# Whisper model options: tiny, base, small, medium, large, large-v3
# Larger models are more accurate but require more resources
whisper_model    = "large-v3"
# ISO 639-1 language code: es (Spanish), en (English), fr (French), etc.
whisper_language = "es"

# ========== Networking ==========
vpc_cidr = "10.0.0.0/16"
