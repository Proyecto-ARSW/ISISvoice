# ====================
# MongoDB Configuration
# ====================
# For MongoDB Atlas (cloud)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=app
# For local MongoDB
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voice_medical

# MongoDB Connection Timeouts (milliseconds)
MONGO_SERVER_SELECTION_TIMEOUT_MS=6000
MONGO_CONNECT_TIMEOUT_MS=6000
MONGO_SOCKET_TIMEOUT_MS=10000
MONGO_OPERATION_TIMEOUT_SECONDS=2.5
MONGO_MAX_RETRIES=1


# ====================
# Whisper Configuration
# ====================
# Model size: tiny, base, small, medium, large, large-v3
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=es
WHISPER_TIMEOUT_SECONDS=45
WHISPER_MAX_RETRIES=1
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_NO_SPEECH_THRESHOLD=0.45
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.2
WHISPER_CHUNK_SECONDS=4.0
WHISPER_MIN_DURATION_SECONDS=1.2


# ====================
# Ollama Configuration (Optional)
# ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=clinical-intake
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_MAX_RETRIES=1
OLLAMA_CHAT_FORMAT=
OLLAMA_FINAL_FORMAT=


# ====================
# Triage Webhook
# ====================
TRIAGE_WEBHOOK_URL=https://asclepio-triage-api.azurewebsites.net/
TRIAGE_WEBHOOK_TOKEN=replace_with_webhook_token
TRIAGE_WEBHOOK_TIMEOUT_SECONDS=12
TRIAGE_WEBHOOK_MAX_RETRIES=1


# ====================
# Session Configuration
# ====================
SESSION_QUEUE_MAX_SIZE=32
MAX_HISTORY_MESSAGES=40


# ====================
# JWT Validation (Main Backend)
# ====================
# Use the same JWT secret configured in ASCLEPIO-NestJS-M1
JWT_SECRET=replace_with_main_backend_jwt_secret
JWT_ALGORITHM=HS256


# ====================
# External Services (Optional)
# ====================
CANVAS_ACCESS_TOKEN=your_canvas_token_here
