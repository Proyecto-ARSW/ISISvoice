# ====================
# MongoDB Configuration
# ====================
# For MongoDB Atlas (cloud)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=app
# For local MongoDB
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voice_medical

# MongoDB Connection Timeouts (milliseconds)
MONGO_SERVER_SELECTION_TIMEOUT_MS=6000
MONGO_CONNECT_TIMEOUT_MS=6000
MONGO_SOCKET_TIMEOUT_MS=10000
MONGO_OPERATION_TIMEOUT_SECONDS=2.5
MONGO_MAX_RETRIES=1


# ====================
# Whisper Configuration (AWS Remote)
# ====================
# Whisper API endpoint on AWS instance (IP:port or DNS)
# Example: http://54.123.45.67:8001 or http://whisper-aws.example.com:8001
WHISPER_API_URL=http://localhost:8001
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=es
WHISPER_TIMEOUT_SECONDS=45
WHISPER_MAX_RETRIES=1


# ====================
# Ollama Configuration (AWS Remote)
# ====================
# Ollama API endpoint on AWS instance (IP:port or DNS)
# Example: http://54.123.45.67:11434 or http://ollama-aws.example.com:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medical3.1
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_MAX_RETRIES=1
OLLAMA_CHAT_FORMAT=
OLLAMA_FINAL_FORMAT=


# ====================
# Session Configuration
# ====================
SESSION_QUEUE_MAX_SIZE=32
MAX_HISTORY_MESSAGES=40


# ====================
# JWT Validation (Main Backend)
# ====================
# Use the same JWT secret configured in ASCLEPIO-NestJS-M1
JWT_SECRET=replace_with_main_backend_jwt_secret
JWT_ALGORITHM=HS256


# ====================
# External Services (Optional)
# ====================
CANVAS_ACCESS_TOKEN=your_canvas_token_here

# ====================
# Triage Webhook (Final step)
# ====================
TRIAGE_API_URL=
TRIAGE_API_KEY=
TRIAGE_WEBHOOK_TIMEOUT_SECONDS=10
