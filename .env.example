# ====================
# MongoDB
# ====================
# Atlas (cloud):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=app
# Local:
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=voice_medical
MONGO_SERVER_SELECTION_TIMEOUT_MS=6000
MONGO_CONNECT_TIMEOUT_MS=6000
MONGO_SOCKET_TIMEOUT_MS=10000
MONGO_OPERATION_TIMEOUT_SECONDS=2.5
MONGO_MAX_RETRIES=1


# ====================
# Ollama — LLM (GPU server)
# ====================
# URL of the Ollama server (docker-compose.gpu-server.yml or bare metal)
OLLAMA_BASE_URL=http://<gpu-server-ip>:11434
OLLAMA_MODEL=clinical-intake
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_MAX_RETRIES=1
# Max concurrent Ollama requests before falling to heuristics
OLLAMA_MAX_CONCURRENT=2
OLLAMA_CHAT_FORMAT=
OLLAMA_FINAL_FORMAT=


# ====================
# Whisper — speech-to-text (GPU server)
# ====================
# URL of the Whisper microservice (docker-compose.gpu-server.yml)
# Leave empty to run Whisper locally inside this process (not recommended in Azure).
WHISPER_API_URL=http://<gpu-server-ip>:8001
WHISPER_MODEL=base
WHISPER_LANGUAGE=es
WHISPER_TIMEOUT_SECONDS=45
WHISPER_MAX_RETRIES=1
WHISPER_BEAM_SIZE=5
WHISPER_BEST_OF=5
WHISPER_NO_SPEECH_THRESHOLD=0.45
WHISPER_LOGPROB_THRESHOLD=-1.0
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.2
WHISPER_CHUNK_SECONDS=4.0
WHISPER_MIN_DURATION_SECONDS=1.2


# ====================
# Triage Webhook (ASCLEPIO-NestJS-M1)
# ====================
TRIAGE_WEBHOOK_URL=https://asclepio-triage-api.azurewebsites.net/api/triage/recepcion/ingreso-isisvoice
TRIAGE_WEBHOOK_TOKEN=replace_with_isisvoice_api_key
TRIAGE_WEBHOOK_TIMEOUT_SECONDS=12
TRIAGE_WEBHOOK_MAX_RETRIES=1
TRIAGE_HOSPITAL_ID=1
TRIAGE_ENFERMERO_ID=replace_with_enfermero_uuid


# ====================
# Session
# ====================
SESSION_QUEUE_MAX_SIZE=32
MAX_HISTORY_MESSAGES=40


# ====================
# JWT (must match ASCLEPIO-NestJS-M1)
# ====================
JWT_SECRET=replace_with_main_backend_jwt_secret
JWT_ALGORITHM=HS256
